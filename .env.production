# ============================================================
# SAP Panda Next.js — Production Environment (Standalone)
# WordPress リモートサーバー接続設定
# ============================================================
# 注意:
#   NEXT_PUBLIC_* 変数はビルド時にバンドルに埋め込まれます。
#   そのため Docker ビルド時か、docker run -e で設定してください。
#   Server Components の fetch 先に使われます。
#
#   Client Components は相対パス /wp-json/ でリクエストし、
#   next.config.js の rewrites がリモート WordPress へプロキシします。

# WordPress REST API のベースURL（既存の WordPress サーバー）
NEXT_PUBLIC_WP_URL=https://sap-navi.aladdin-techec.com

# SAP Panda API ベースURL
NEXT_PUBLIC_API_BASE=https://sap-navi.aladdin-techec.com/wp-json/sap/v1

# Next.js の公開ドメイン（SEO / OGP メタタグ用）
# ⚠️ 実際のデプロイ先ドメインに変更してください
NEXT_PUBLIC_SITE_URL=https://sap-navi.aladdin-techec.com

# Google Analytics 4 Measurement ID
# 空欄の場合は GA トラッキングコードを読み込みません
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
